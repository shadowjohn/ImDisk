<Window x:Class="ImDiskGui.DiskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImDiskGui"
        Title="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgAddTitle]}" Height="420" Width="480"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Form fields -->
        <StackPanel Grid.Row="0">
            <!-- Disk Size -->
            <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgSize]}" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSize" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBoxForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}" Text="128"/>
                <TextBlock x:Name="TxtFreeSpace" Grid.Column="1" Text="Calculated Free RAM" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
            </Grid>

            <!-- Backing Image File -->
            <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgBackup]}" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtImagePath" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBoxForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                <Button x:Name="BtnBrowseImage" Grid.Column="1" Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgBrowse]}" Width="75" Height="26" Margin="5,0,0,0" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Click="BtnBrowseImage_Click"/>
            </Grid>

            <!-- Drive Letter & File System -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Drive Letter -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgDrive]}" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox x:Name="ComboDriveLetter" Height="26" Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBoxForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                </StackPanel>
                <!-- File System -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgFS]}" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox x:Name="ComboFileSystem" Height="26" SelectedIndex="0" Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBoxForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <ComboBoxItem Content="NTFS"/>
                        <ComboBoxItem Content="exFAT"/>
                        <ComboBoxItem Content="FAT32"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Options -->
            <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgOptions]}" Margin="0,0,0,5" Foreground="{DynamicResource TextBrush}"/>
            <StackPanel Margin="0,0,0,15">
                <CheckBox x:Name="ChkSaveOnShutdown" Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgSave]}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,5" Checked="ChkSaveOnShutdown_Checked" Unchecked="ChkSaveOnShutdown_Unchecked"/>
                <CheckBox x:Name="ChkRemovable" Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgRemovable]}" Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <!-- Auto Save Interval -->
            <StackPanel x:Name="PanelAutoSave" Orientation="Horizontal" Margin="0,0,0,15" IsEnabled="{Binding ElementName=ChkSaveOnShutdown, Path=IsChecked}">
                <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgAutoSaveInterval]}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextBrush}"/>
                <ComboBox x:Name="ComboAutoSave" Width="150" Height="26" VerticalAlignment="Center" SelectedIndex="0" Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBoxForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <ComboBoxItem Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[AutoSaveManual]}" Tag="0"/>
                    <ComboBoxItem Content="1 分鐘 (1 min)" Tag="1"/>
                    <ComboBoxItem Content="3 分鐘 (3 min)" Tag="3"/>
                    <ComboBoxItem Content="5 分鐘 (5 min)" Tag="5"/>
                    <ComboBoxItem Content="10 分鐘 (10 min)" Tag="10"/>
                    <ComboBoxItem Content="30 分鐘 (30 min)" Tag="30"/>
                    <ComboBoxItem Content="60 分鐘 (60 min)" Tag="60"/>
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOK" Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgOK]}" Width="80" Height="28" Background="#38E54D" Foreground="#121212" FontWeight="Bold" BorderThickness="0" Click="BtnOK_Click" Margin="0,0,10,0"/>
            <Button x:Name="BtnCancel" Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgCancel]}" Width="80" Height="28" Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
