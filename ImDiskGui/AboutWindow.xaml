<Window x:Class="ImDiskGui.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImDiskGui"
        Title="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[AboutTitle]}"
        SizeToContent="Height" Width="460"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="AboutCaptionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="AboutValueText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CollabBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="74" Height="74" CornerRadius="37" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="#38E54D" BorderThickness="1" HorizontalAlignment="Left">
                <Image Source="Assets/about-avatar.png" Width="72" Height="72" Stretch="UniformToFill" SnapsToDevicePixels="True"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[AppTitle]}"
                           FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[AboutRole]}"
                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Project Information -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[AboutVersion]}" Style="{StaticResource AboutCaptionText}"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="1.01" Style="{StaticResource AboutValueText}" FontWeight="SemiBold"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[AboutAuthor]}" Style="{StaticResource AboutCaptionText}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource AboutValueText}">
                    <Run Text="羽山"/>
                    <Run Text="  "/>
                    <Hyperlink NavigateUri="https://3wa.tw" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#2196F3">
                        <Run Text="3wa.tw"/>
                    </Hyperlink>
                </TextBlock>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[AboutCore]}" Style="{StaticResource AboutCaptionText}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="ImDisk Virtual Disk Driver" Style="{StaticResource AboutValueText}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[AboutCollab]}" Style="{StaticResource AboutCaptionText}"/>
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                    <Border Style="{StaticResource CollabBadge}">
                        <TextBlock Text="Gemini" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Style="{StaticResource CollabBadge}">
                        <TextBlock Text="Codex" Foreground="{DynamicResource TextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Buttons row: Driver maintenance + Close side by side -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="btnDriverMaintenance" Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DriverMaintenance]}"
                    Width="138" Height="30" Margin="0,0,10,0" FontSize="12"
                    Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Cursor="Hand"
                    Click="BtnDriverMaintenance_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgOK]}"
                    Width="88" Height="30" FontSize="12"
                    Background="#38E54D" Foreground="#121212" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"
                    Click="BtnClose_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
