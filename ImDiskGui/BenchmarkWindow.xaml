<Window x:Class="ImDiskGui.BenchmarkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ImDiskGui"
        Title="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchTitle]}" Height="470" Width="800"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Background" Value="{DynamicResource ToolbarBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="SummaryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchTitle]}" FontSize="22" FontWeight="SemiBold" Foreground="#38E54D"/>
                <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchDesc]}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchModeHint]}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Configuration Bar -->
        <Border Grid.Row="1" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgDrive]}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Grid.Column="1" x:Name="TxtDriveLetter" Text="R:" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Grid.Column="3" Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchProfile]}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <ComboBox Grid.Column="4" x:Name="ComboTestProfile" Height="28" SelectedIndex="0"
                          Background="{DynamicResource TextBoxBackgroundBrush}" Foreground="{DynamicResource TextBoxForegroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <ComboBoxItem Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchQuick]}" Tag="Quick"/>
                    <ComboBoxItem Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchStandard]}" Tag="Standard"/>
                    <ComboBoxItem Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchStress]}" Tag="Stress"/>
                </ComboBox>

                <Button Grid.Column="6" x:Name="BtnStart" Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchStart]}" Height="28"
                        Background="#38E54D" Foreground="#121212" FontWeight="SemiBold" BorderThickness="0"
                        Click="BtnStart_Click"/>
            </Grid>
        </Border>

        <!-- Benchmark Display -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <UniformGrid Grid.Column="0" Columns="2" Rows="2" Margin="-5">
                <Border Style="{StaticResource MetricCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchSeqRead]}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtSeqRead" Text="-- MB/s" FontSize="29" FontWeight="SemiBold" Foreground="#38E54D" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchSeqWrite]}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtSeqWrite" Text="-- MB/s" FontSize="29" FontWeight="SemiBold" Foreground="#38E54D" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchRandRead]}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtRandRead" Text="-- MB/s" FontSize="29" FontWeight="SemiBold" Foreground="#2196F3" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MetricCard}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchRandWrite]}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtRandWrite" Text="-- MB/s" FontSize="29" FontWeight="SemiBold" Foreground="#2196F3" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Column="1" Margin="12,0,0,0" Padding="14" Background="{DynamicResource ToolbarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchSystemSummary]}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchCpu]}" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="TxtCpuInfo" Text="-" Style="{StaticResource SummaryValue}"/>

                    <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchRam]}" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="TxtRamInfo" Text="-" Style="{StaticResource SummaryValue}"/>

                    <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchRamDisk]}" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="TxtRamDiskInfo" Text="-" Style="{StaticResource SummaryValue}"/>

                    <TextBlock Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchElapsed]}" Style="{StaticResource SummaryLabel}"/>
                    <TextBlock x:Name="TxtElapsedInfo" Text="-" Style="{StaticResource SummaryValue}" Margin="0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status & Progress -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TxtStatus" Text="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[BenchReady]}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,6"/>
                <ProgressBar x:Name="ProgressBenchmark" Height="10" Background="{DynamicResource ButtonBackground}" Foreground="#38E54D" BorderThickness="0"/>
            </StackPanel>
            <Button x:Name="BtnClose" Grid.Column="1" Content="{Binding Source={x:Static local:LanguageManager.Instance}, Path=[DlgClose]}" Width="88" Height="30" Margin="15,0,0,0"
                    Background="{DynamicResource ButtonBackground}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Click="BtnClose_Click"/>
        </Grid>
    </Grid>
</Window>
